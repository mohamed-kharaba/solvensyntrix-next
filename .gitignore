# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
html/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
html/.next/
/out/
html/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!html/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
html/next-env.d.ts
